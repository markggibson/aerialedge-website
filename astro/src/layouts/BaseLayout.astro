---
// BaseLayout.astro — replaces v1 _layouts/default.html
// (and _layouts/landing-page.html, which is byte-identical to default — see
// migration plan §4 for the collapse decision).
//
// Renders the HTML shell: <head>, <body>, top anchor, Header, #main wrapper,
// FooterMenu. Same structure as v1; one-pager mode is a prop (replaces
// page.onepage in Liquid). OnePageLayout.astro wraps this with onepage=true.

import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import FooterMenu from '../components/FooterMenu.astro';
import Analytics from '../components/Analytics.astro';

export interface Props {
  title?: string;
  description?: string;
  onepage?: boolean;
  bodyClass?: string;
  lang?: string;
  /**
   * Optional per-page RSS feeds (added 2026-06-13 task #678 for newsletter).
   * Passed through to Head.astro as additional <link rel="alternate"> entries.
   */
  extraRssFeeds?: Array<{ title: string; href: string }>;
}

const {
  title,
  description,
  onepage = false,
  bodyClass = '',
  lang = 'en',
  extraRssFeeds,
} = Astro.props;

const mainClass = onepage ? 'top-shift' : '';
---
<!DOCTYPE html>
<html lang={lang}>
  <Head title={title} description={description} extraRssFeeds={extraRssFeeds} />
  <body class={bodyClass}>
    <a id="top"></a>

    <Header onepage={onepage} />

    <div id="main" class={mainClass}>
      <slot />
    </div>

    <FooterMenu />

    {/* GA4 tag + consent banner + conversion events (task #1308).
        Measurement ID configured in src/data/analytics.ts — one config point. */}
    <Analytics />
  </body>
</html>
