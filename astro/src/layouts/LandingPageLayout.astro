---
// LandingPageLayout.astro — campaign landing-page layout (task #207).
//
// Used by [landing_slug].astro for the `landing-pages` Content Collection.
// Deliberately custom (not a course-page port) — campaign LPs need a focused
// hero + body + CTA shape, not the course-page video parallax sections. The
// course pages stay hand-built per-course; this layout is for Sveltia-created
// campaign LPs Mark spins up without dev involvement.
//
// DOM order (task #213 r3 — mirrors WorkLayout's *body section* shape):
//   1. Hero image — full-width (large-12 columns), matching the portfolio
//      works image size; skipped entirely if `hero_image` is not set
//   2. `four spacing` divider — same vertical rhythm WorkLayout uses between
//      its slider and body
//   3. Content block in a large-12 column (text width matches image width
//      per Mark's r3 request):
//        a. Category — small-title kicker (<p class="small-title">), only
//           rendered when the optional `category` field is set
//        b. Title — <h3>, matching the body-side title typography in WorkLayout
//        c. Body markdown — rendered via <slot />
//        d. CTA button — below body, only if both `cta.text` and `cta.url`
//           are set
//   4. `four spacing` closer
//
// History:
//   r1 (bc41157, #212) — DOM reshuffle: title block + image + body + CTA.
//   r2 (3c1ef9e, #212) — narrowed hero to large-8 to align with body column.
//   r3 (#213, this) — Mark's feedback: drop the title-above-image block,
//      widen image to large-12, widen body column to large-12 (matching
//      image), introduce optional category kicker above the title.
//
// WorkLayout's right-side meta sidebar and prev/next nav are intentionally
// dropped: LPs don't carry client/date metadata and aren't browsable as a
// series. BaseLayout's chrome (header/footer) is preserved for site styling.

import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description?: string;
  category?: string;
  hero_image?: string;
  cta?: { text: string; url: string };
}

const { title, description, category, hero_image, cta } = Astro.props;
---
<BaseLayout title={title} description={description}>
  {hero_image && (
    <div class="full no-padding">
      <div class="row">
        <div class="large-12 columns">
          <img src={hero_image} alt="" />
        </div>
      </div>
    </div>
  )}

  {/* Vertical rhythm spacer between hero image and body — mirrors WorkLayout. */}
  <div class="four spacing"></div>

  <div class="full no-padding">
    <div class="row">
      <div class="large-12 columns">
        {category && (
          <p class="small-title">{category}</p>
        )}
        <h3>{title}</h3>
        <div class="mod modBlogPost big no_bg">
          <slot />
          {cta && cta.text && cta.url && (
            <p>
              <div class="two spacing"></div>
              <a class="button small" href={cta.url}>{cta.text}</a>
            </p>
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="four spacing"></div>
</BaseLayout>
