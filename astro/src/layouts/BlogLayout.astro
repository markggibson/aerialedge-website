---
// BlogLayout.astro — replaces v1 _layouts/blog.html.
//
// Three-column structure: section-title banner, large-9 main column with
// content slot, large-3 sidebar (recent posts / categories / tags / archives).
// Sidebar props default to empty arrays — Phase 4 fills them from the posts
// collection.

import BaseLayout from './BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SidebarRecentPosts from '../components/sidebar/SidebarRecentPosts.astro';
import SidebarCategories from '../components/sidebar/SidebarCategories.astro';
import SidebarTags from '../components/sidebar/SidebarTags.astro';
import SidebarArchives from '../components/sidebar/SidebarArchives.astro';

export interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  recentPosts?: Array<{ url: string; title: string }>;
  categories?: string[];
  tags?: string[];
  archives?: Array<{ name: string; hash: string; count: number }>;
  sectionSmallTitle?: string;
  sectionTitle?: string;
}

const {
  title,
  description,
  bodyClass,
  recentPosts = [],
  categories = [],
  tags = [],
  archives = [],
  sectionSmallTitle = 'our blog',
  sectionTitle = 'Articles',
} = Astro.props;
---
<BaseLayout title={title} description={description} bodyClass={bodyClass}>
  <div class="full">
    <div class="row">
      <div class="large-8 columns large-centered">
        <SectionTitle smallTitle={sectionSmallTitle} title={sectionTitle} />
      </div>
    </div>
  </div>

  <div class="full no-padding">
    <div class="row">
      <div class="large-9 columns">
        <slot />
      </div>
      <div class="large-3 columns" id="sidebar">
        <SidebarRecentPosts posts={recentPosts} />
        <SidebarCategories categories={categories} />
        <SidebarTags tags={tags} />
        <SidebarArchives archives={archives} />
        <div class="four spacing"></div>
      </div>
    </div>
  </div>
</BaseLayout>
