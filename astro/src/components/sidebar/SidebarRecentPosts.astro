---
// SidebarRecentPosts.astro — replaces v1 _includes/sidebar-recent-posts.html.
//
// Phase 4 will pull the posts collection and render the latest N entries.
// Phase 3 stubs the shell so BlogLayout has the right structure to compose.

export interface Props {
  posts?: Array<{ url: string; title: string }>;
  limit?: number;
}

const { posts = [], limit = 10 } = Astro.props;
const items = posts.slice(0, limit);
---
<div class="links">
  <h3>Recent Posts</h3>
  <ul>
    {items.map((post) => (
      <li>
        <a href={post.url}>{post.title}</a>
      </li>
    ))}
  </ul>
</div>
