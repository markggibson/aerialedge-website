---
// SidebarArchives.astro — replaces v1 _includes/sidebar-archives.html.
//
// v1 grouped posts by "%B %Y" (e.g. "October 2024") and rendered count per
// group. Phase 4 hydrates the prop from the posts collection.
// Phase 6 (#190): /blog/archives/ link respects base for /v2/ staging.

import { withBase } from '../../utils/url';

export interface Props {
  archives?: Array<{ name: string; hash: string; count: number }>;
}

const { archives = [] } = Astro.props;
---
<div class="links">
  <h3>Archives</h3>
  <ul>
    {archives.map((archive) => (
      <li>
        <a href={`${withBase('/blog/archives/')}#${archive.hash}`}>{archive.name}</a>
        <span>({archive.count})</span>
      </li>
    ))}
  </ul>
</div>
