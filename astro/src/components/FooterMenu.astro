---
// FooterMenu.astro — replaces v1 _includes/footer-menu.html.
//
// P4-A (Mark approved 2026-05-15): v1 hard-coded absolute aerialedge.co.uk
// URLs in every footer link; on the new build these are root-relative so
// the same markup works on the staging subfolder and post-cutover root.
//
// Lift-and-shift quirks preserved:
//   - "Youth Circus Performance Programme" link is commented out in v1.
//     Carried across as an HTML comment for fidelity.
//
// v1 also looped through `_data/assets.yml` js: list and emitted a <script>
// tag per file. Phase 3 stripped Bower entirely (P3-C lean): jQuery,
// Foundation JS, terrific, slick, etc. are NOT loaded site-wide. The only
// script loaded here is the new vanilla menu toggler. Per-page scripts
// (homepage Masonry) are loaded by the page that needs them.
//
// Phase 6 (#190): internal links route through withBase() so they work
// at both `/` and `/v2/`. The /assets/* JS reference stays root-relative
// per P6-E (resolves to v1's tree during staging).

import { withBase } from '../utils/url';

const year = new Date().getFullYear();
---
<div class="full no-padding dark">
  <div class="four spacing"></div>
  <div id="footer" class="centered-text">
    <div class="row">
      <div class="large-6 columns">
        <div style="text-align: left;">
          <p class="small-title">Information</p>
          <ul>
            <li><a href={withBase('/#top')}>Home</a></li>
            <li><a href={withBase('/#about')}>About</a></li>
            <li><a href={withBase('/#works')}>Classes & Courses</a></li>
            <li><a href={withBase('/#pricing')}>Pricing</a></li>
            <li><a href={withBase('/#vouchers')}>Vouchers</a></li>
            <li><a href="https://store.aerialedge.co.uk/" target="_blank">Clothing Store</a></li>
            <li><a href={withBase('/blog/')}>Blog</a></li>
            <li><a href={withBase('/newsletter/')}>Newsletter Archive</a></li>
            <li><a href={withBase('/#contact')}>Contact Us</a></li>
            <li><a href={withBase('/privacy/')}>Privacy Policy</a></li>
            <li><a href={withBase('/terms/')}>Terms of Service</a></li>
            <li><a href={withBase('/safeguarding/')}>Safeguarding Policy</a></li>
          </ul>
        </div>
      </div>
      <div class="large-6 columns">
        <div style="text-align: right;">
          <p class="small-title">What we do</p>
          <ul>
            <li><a href={withBase('/portfolio/circus-fitness/')}>Circus Fitness</a></li>
            <li><a href={withBase('/portfolio/aerial-acrobatic-arts/')}>Aerial & Acrobatic Arts</a></li>
            <li><a href={withBase('/portfolio/youth-circus/')}>Youth Circus</a></li>
            {/* v1 quirk: commented-out link preserved for fidelity. */}
            {/* <li><a href={withBase('/youth-performance/')}>Youth Circus Performance Programme</a></li> */}
            <li><a href={withBase('/portfolio/rigging-training/')}>Rigging Training</a></li>
            <li><a href={withBase('/portfolio/parties-private-lessons/')}>Parties & Private Lessons</a></li>
            <li><a href={withBase('/easter-edge/')}>Easter Edge</a></li>
            <li><a href={withBase('/foundation-course/')}>Foundation Course</a></li>
            <li><a href={withBase('/four-week-intensive/')}>Four Week Intensive</a></li>
            <li><a href={withBase('/protrack/')}>Pro Track</a></li>
            <li><a href={withBase('/professional-development-programme/')}>Professional Development Programme</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="four spacing"></div>
    <div class="row">
      <div class="large-12 columns">
        <h4>©{year} Aerial Edge Circus School C.I.C. All rights reserved.</h4>
      </div>
    </div>
  </div>
  <div class="four spacing"></div>
</div>

<!--
  Site-wide JS: just the new vanilla menu toggler. Bower (jQuery,
  imagesloaded, masonry, foundation) is no longer loaded site-wide. Masonry
  + imagesloaded are vendored at /assets/javascripts/ and invoked only by
  the pages that need them (homepage works grid).
-->
<script src="/assets/javascripts/menu-toggler.js" type="text/javascript"></script>
