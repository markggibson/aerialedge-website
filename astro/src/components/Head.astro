---
// Head.astro — replaces v1 _includes/head.html.
//
// Phase 3 of the migration. Mirrors v1's <head> verbatim:
//   - Five vendored stylesheets at /assets/css/ (P3-A locked).
//   - Two Google Fonts links (Poppins + Raleway).
//   - Canonical link + RSS alternate.
//   - Favicon block (kept as-is; the favicon files themselves live on Rochen
//     post-cutover — Phase 6 territory. Hrefs unchanged from v1.)
//
// Site title comes from a hard-coded "Aerial Edge" default; per-page title
// override via the `title` prop.

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /**
   * Optional per-page Open Graph image. Root-relative path (e.g.
   * `/assets/images/foo.jpg`) — Head.astro will absolutise it against
   * the canonical site origin. Falls back to the site logo if absent.
   *
   * NOTE: the fallback /assets/images/AELogoWhiteOnly.png is the
   * brandmark, not a 1200x630 OG-ideal social card. A proper OG card
   * is pending an Iris brief (task #312 follow-up). Once that ships,
   * swap the OG_FALLBACK constant below.
   */
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = "Aerial Edge founded in 2007 is Glasgow's circus school. Developing people through circus.",
  canonical,
  ogImage,
  ogType = 'website',
} = Astro.props;

const siteTitle = 'Aerial Edge';
const pageTitle = title ? title : siteTitle;

// Task #312 (2026-05-26) — canonical site origin for absolute URLs in
// canonical / OG / Twitter / JSON-LD. The apex URL never changes per
// build target; staging-vs-apex shape is handled by stripping the
// /preview/ prefix from the path below before composing canonical.
const SITE_ORIGIN = 'https://aerialedge.co.uk';

// Canonical URL: prefer explicit prop; else derive from current pathname.
// Strip any `/preview/` prefix so canonical always points to the apex
// version of the page (per Mark's #312 decision). On apex builds
// BASE_URL is `/` so the stripping is a no-op; on staging builds
// BASE_URL is `/preview/` and we want the canonical href to advertise
// the apex URL rather than the staging-shaped one.
const rawPath = canonical ?? Astro.url.pathname;
const canonicalPath = rawPath.replace(/^\/preview(\/|$)/, '/');
const canonicalHref = new URL(canonicalPath, SITE_ORIGIN).href;

// Open Graph image — absolute URL required by the spec. Default is the
// AE logo; a per-page override comes through `ogImage`.
const OG_FALLBACK = '/assets/images/AELogoWhiteOnly.png';
const ogImageHref = new URL(ogImage ?? OG_FALLBACK, SITE_ORIGIN).href;

// Task #215 (2026-05-17) — staging/preview SEO block. When the build is
// running with SITE_BASE=/preview/ (i.e. import.meta.env.BASE_URL ===
// '/preview/'), emit a robots noindex/nofollow meta tag in <head>.
// Paired with the public_html/preview/robots.txt that deploy-staging.yml
// drops on Rochen — robots.txt blocks crawling, the meta tag blocks
// indexing if anything slips through. Apex prod build (BASE_URL === '/')
// emits no such tag.
const isPreviewBuild = import.meta.env.BASE_URL === '/preview/';
---
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {isPreviewBuild && <meta name="robots" content="noindex,nofollow" />}

  <title>{pageTitle}</title>
  <meta name="description" content={description} />

  {/*
    Task #312 (2026-05-26) — Open Graph + Twitter Card meta tags.

    Renders absolute URLs against https://aerialedge.co.uk (the
    canonical apex). On staging builds the canonical/og:url get the
    /preview/ prefix stripped so social shares of /preview/ URLs still
    advertise the apex page — staging traffic is robots-blocked anyway,
    but the head shape is the same as apex (defence in depth).

    og:image defaults to /assets/images/AELogoWhiteOnly.png. That is
    the brandmark, not a purpose-built 1200x630 social card. A proper
    OG image is pending an Iris brief (#312 follow-up).
  */}
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={siteTitle} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalHref} />
  <meta property="og:image" content={ogImageHref} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageHref} />

  <link rel="stylesheet" href="/assets/css/foundation.css" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link rel="stylesheet" href="/assets/css/patch.css" />
  {import.meta.env.BASE_URL === '/preview/' && (
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}assets/css/preview-overrides.css`} />
  )}
  <link rel="stylesheet" href="/assets/css/fontello.css" />
  <link rel="stylesheet" href="/assets/css/font-awesome.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Raleway:400,700,300" />

  <link rel="canonical" href={canonicalHref} />
  <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/feed.xml" />

  <!-- favicon — paths preserved verbatim from v1 _includes/head.html. -->
  <link rel="apple-touch-icon" sizes="57x57" href="/assets/favicon/apple-icon-57x57.png" />
  <link rel="apple-touch-icon" sizes="60x60" href="/assets/favicon/apple-icon-60x60.png" />
  <link rel="apple-touch-icon" sizes="72x72" href="/assets/favicon/apple-icon-72x72.png" />
  <link rel="apple-touch-icon" sizes="76x76" href="/assets/favicon/apple-icon-76x76.png" />
  <link rel="apple-touch-icon" sizes="114x114" href="/assets/favicon/apple-icon-114x114.png" />
  <link rel="apple-touch-icon" sizes="120x120" href="/assets/favicon/apple-icon-120x120.png" />
  <link rel="apple-touch-icon" sizes="144x144" href="/assets/favicon/apple-icon-144x144.png" />
  <link rel="apple-touch-icon" sizes="152x152" href="/assets/favicon/apple-icon-152x152.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-icon-180x180.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon/android-icon-192x192.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon/favicon-96x96.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png" />
  <link rel="manifest" href="/assets/favicon/manifest.json" />
  <meta name="msapplication-TileColor" content="#ffffff" />
  <meta name="msapplication-TileImage" content="/assets/favicon/ms-icon-144x144.png" />
  <meta name="theme-color" content="#ffffff" />
</head>
