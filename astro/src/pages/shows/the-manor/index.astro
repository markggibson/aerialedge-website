---
// /shows/the-manor/ — port of v1 shows/the-manor.html.
// v1 permalink: /shows/the-manor/.

import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
---
<BaseLayout title="Aerial Edge — The Manor">
  <div class="full">
    <div class="row">
      <div class="large-8 columns large-centered">
        <SectionTitle smallTitle="2023 events" title="The Manor" />
      </div>
    </div>
  </div>

  <div class="full no-padding">
    <div class="row">
      <div class="large-6 columns">
        <img src="/assets/images/shows/The-Manor-lores.jpg" />
      </div>

      <div class="large-6 columns">
        <h3>The Manor</h3>
        <p>Enter a world of mystery, intrigue, and suspense as you join our talented performers in unraveling a perplexing mystery that has taken place within the confines of The Manor. </p>

        <p>You will be introduced to a diverse cast of characters, each with their own unique style and secrets. Featuring rope, silks, Chinese pole and more. </p>

        <p>The Manor sees our diverse cast of Foundation Course students bringing circus and theatre together in a way never seen in an Aerial Edge show.</p>

        <p>Director Michelle Ross says: "I wanted to create a performance that showcased the range of skills the students developed on the course. </p>

        <p>"I've always been interested in bringing circus and theatre together and this has been an amazing opportunity to fuse character, storytelling, and circus."</p>

        <p>Cast: MONIKA JAROSIKOVA, LOIS ROLPH, KENZIE HUEBSCHMAN, CONNIE ROSE, PADRAIC RIDDLE</p>

        <p>DIRECTED BY MICHELLE ROSS, PRODUCED BY VEE SMITH</p>
      </div>
      <div class="one spacing"></div>
    </div>
  </div>

  <div class="four spacing"></div>

  <div class="full no-padding">
    <div class="row">
      <div class="large-4 columns">
        <div style="text-align: center;">
          <h3>The Cast</h3>
