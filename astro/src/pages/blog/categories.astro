---
// /blog/categories/ — category index, mirrors v1 categories.html.
// Sidebar items anchor here with #<slugified-category>.

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getSortedPosts, postHref, slugify } from '../../utils/blog';

const posts = await getSortedPosts();

const groups = new Map<string, { url: string; title: string }[]>();
for (const p of posts) {
  for (const cat of p.data.categories ?? []) {
    const arr = groups.get(cat) ?? [];
    arr.push({ url: postHref(p), title: p.data.title });
    groups.set(cat, arr);
  }
}
const sortedCats = Array.from(groups.keys()).sort();
---
<BaseLayout title="Aerial Edge — Categories">
  <div class="full">
    <div class="row">
      <div class="large-8 columns large-centered">
        <SectionTitle smallTitle="category index" title="Articles" />
      </div>
    </div>
  </div>

  <div class="full no-padding">
    <div class="row">
      <div class="large-8 large-centered columns">
        <dl>
          {sortedCats.map((name) => (
            <>
              <dt id={slugify(name)}>{name}</dt>
              <dd>
                <ul>
                  {groups.get(name)!.map((item) => (
                    <li>
                      <a href={item.url}>{item.title}</a>
                    </li>
                  ))}
                </ul>
              </dd>
            </>
          ))}
        </dl>
      </div>
    </div>
  </div>
</BaseLayout>
