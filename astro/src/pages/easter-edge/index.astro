---
// /easter-edge/ — port of v1 easter-edge.html. v1 permalink: /easter-edge/.
//
// £ figures present that R1 did NOT cover: £269 (pass), flagged to Cord
// per Phase 4 brief — carry v1 verbatim, do not silently correct.

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
---
<BaseLayout title="Aerial Edge — Easter Edge">
  <div class="full">
    <div class="row">
      <div class="large-8 columns large-centered">
        <SectionTitle smallTitle="Events" title="Easter Edge" />
      </div>
    </div>
  </div>

  <div class="full no-padding">
    <div class="row">
      <h3>Easter Edge Circus Festival</h3>
      <div>
        <img width="50%" src="/assets/images/posts/EasterEdgeSchedule.png" style="float: left; margin-right: 10px;" />
      </div>

      <p>This is a fantastic four full days giving you 24 hours of progress-driven training with the Aerial Edge team and specialist guest instructors. </p>

      <p>You choose four arts to focus on over the four days. Each pathway has a 90-minute session in that art every day, for four days. </p>

      <p>People make appreciable improvements because everyone is moving together through the experience, and some arts improve technique in others.</p>

      <p>Each day will have flexibility/mobility and conditioning sessions built in</p>

      <h4>Dates:</h4>
      <ul>
        <li>3rd-6th April 2026</li>
      </ul>

      <h4>Pricing:</h4>
      <ul>
        <li>£269</li>
      </ul>

      <div class="four spacing"></div>
      <div class="four spacing"></div>
      <div class="four spacing"></div>
      <div class="four spacing"></div>
      <div class="four spacing"></div>
      <div class="two spacing"></div>

      <h4> Booking Process</h4>
      <p><b>Step 1</b> <a href="https://goteamup.com/p/3751555-aerial-edge-circus-school/memberships/194625/">- Buy your festival pass - £269</a></p>

      <p><b>Step 2</b> - Select your 4 pathways for the weekend. Go to the Aerial Edge Course Booking page (closer to the time we will release the pathways) and select 1 pathway for each timeslot that you will follow for the 4 days.</p>

      <b>Example timetable</b>

      <p>Timeslot 1 Options - 10:00-11:30</p>
      <ul>
        <li>Flying trapeze</li>
        <li>Doubles trapeze</li>
        <li>Aerial hoop</li>
        <li>Acro</li>
      </ul>

      <p>Timeslot 2 Options - 11:45-13:15</p>
      <ul>
        <li>Flying trapeze & Cradle</li>
        <li>Acrobalance</li>
        <li>Aerial hoop</li>
        <li>Aerial silks</li>
      </ul>

      <p>Timeslot 3 Options - 14:00-15:30</p>
      <ul>
        <li>Aerial rope</li>
        <li>Chinese pole</li>
        <li>Trapeze</li>
        <li>Handstands & handbalance</li>
      </ul>

      <p>Timeslot 4 Options - 15:45-17:15</p>
      <ul>
        <li>Trampoline</li>
        <li>Teeterboard</li>
        <li>Trapeze</li>
        <li>Aerial Straps</li>
      </ul>

      <p><b>Step 3 - Train Circus!</b></p>
    </div>
  </div>
  <div class="four spacing"></div>
  <div class="four spacing"></div>
</BaseLayout>
