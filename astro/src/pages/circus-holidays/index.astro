// Flagged to Cord per Phase 4 brief — carry v1 verbatim.

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
---
<BaseLayout title="Aerial Edge — Circus Holidays">
  <div class="full">
    <div class="row">
      <div class="large-8 columns large-centered">
        <SectionTitle smallTitle="Events" title="Circus Holidays" />
      </div>
    </div>
  </div>

  <div class="full no-padding">
    <div class="row">
      <h3>Circus Holidays</h3>

      <iframe width="560" height="315" src="https://www.youtube.com/embed/P-oAqI4M9xQ?si=_mnwmiX8dZEwe9Fb" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>

      <p>Booking opens on Friday 1st March for the Brazil 2024 training camp, so be ready to roll because there are only 10 spaces. </p>

      <p>Dates: 10th to 24th November 2024 <b>This event is fully booked</b></p>

      <p>This amazing two-week holiday starts with a 5-day all-arts training camp in Circocan circus school's huge ranch, where you can choose just about any schedule you fancy and enjoy superb food and entertainment in the evenings.</p>

      <p>After that, you'll be off to the beautiful island of Florianopolis where you'll have flying trapeze lessons every day at the beach-side grand volant rig, and go for some fabulous sightseeing trips.</p>

      <p>The people who went last year are all fired up to go again this year, it was that good! </p>

      <p>You can pay the total £1,900 or a £300 deposit in the courses section of the Teamup booking system on Friday 1st March.</p>

      <p>If you choose the deposit, this will be followed up by two payments of £800, the first on 1st June and the second on 1st August. The deposit is non-refundable because we'll be using it to book hotels and Circocan.</p>

      <p>We aim to book flights, which are payable separately, soon after the deposits are in. </p>

      <p>We'll post a link on socials on Friday to take you to the booking site, and it will be in the newsletter too. Happy holidays! </p>

      <p>Here's the link to our <a href="/programmes/2023/07/21/brazilliant-chance-to-train.html">blog article on Brazil</a></p>

      <hr />
    </div>
  </div>
  <div class="four spacing"></div>
  <div class="four spacing"></div>
</BaseLayout>
