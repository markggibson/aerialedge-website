---
// /our-team/ — port of v1 our-team.html (`layout: landing-page`, one-pager).
// v1 permalink: /our-team/.
//
// Stock-content lift-and-shift: members[1].avatar 'member-9.png',
// members[2].avatar 'member-8.png', members[3].avatar 'member-4-4.png',
// members2[*] avatars '@stock/*.png', and the Lorem-ipsum descs on
// members2 — all carried verbatim per brief.
//
// Trailing GoHighLevel chat-widget loader script preserved.

import OnePageLayout from '../../layouts/OnePageLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';

interface Social { link: string; icon: string; }
interface Member { avatar: string; name: string; position: string; desc: string; socials: Social[]; }

const members: Member[] = [
  {
    avatar: '/assets/images/team/MarkGibson.jpeg',
    name: 'Mark Gibson',
    position: 'Founder & Director',
    socials: [
      { link: 'https://www.instagram.com/mark_gibson67/', icon: 'instagram' },
      { link: 'https://flickr.com/people/mark_gibson/', icon: 'flickr' },
    ],
    desc:
      "Mark teaches and performs internationally, specialising in static and doubles trapeze, cradle, acrobalance and packing more value into every class and day than seems feasible. Mark studied at The Circus Space in London. He also works in non-circus education systems delivered globally.",
  },
  {
    avatar: '/assets/images/@stock/member-9.png',
    name: 'Sam McFarlane',
    position: 'Acrobatics',
    socials: [
      { link: 'http://twitter.com', icon: 'twitter' },
      { link: 'http://facebook.com', icon: 'facebook' },
      { link: 'http://dribbble.com', icon: 'web' },
    ],
    desc:
      "Easy-going Sam joined the 2014 Commonwealth Youth Circus Programme and now enthusiastically coaches acrobatics, trampolining, parkour, partner acro and juggling. When he’s not teaching or performing, he’ll likely be wild swimming, high diving, freediving or playing board games. Because: rest sometimes.",
