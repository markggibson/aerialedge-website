---
<OnePageLayout title="Aerial Edge — Our Team">
  <a id="team"></a>
  <div class="full dark-grey">
    <div class="row">
      <div class="large-8 columns large-centered">
        <SectionTitle smallTitle="The team" title="This is our team." />
      </div>
    </div>
  </div>

  <div class="full dark-grey no-padding">
    <div class="members">
      {members.map((member) => (
        <div class="small-3 columns">
          <div class="member-avatar">
            <img class="avatar" alt="" src={member.avatar} />
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="full no-padding team-bg">
    <div class="div member-decs">
      {members.map((member) => (
        <div class="large-3 columns">
          <div class="member-dec">
            <div class="intro">
              <h3>{member.name}</h3>
              <h4>{member.position}</h4>
              <p>{member.desc}</p>
              <ul class="socials">
                {member.socials.map((social) => (
                  <li>
                    <a href={social.link}>
                      <i class={`fa fa-${social.icon}`}></i>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="full dark-grey">
    <div class="row"></div>
  </div>
  <div class="full dark-grey no-padding">
    <div class="members">
      {members2.map((member) => (
        <div class="small-3 columns">
          <div class="member-avatar">
            <img class="avatar" alt="" src={member.avatar} />
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="full no-padding team-bg">
    <div class="div member-decs">
      {members2.map((member) => (
        <div class="large-3 columns">
          <div class="member-dec">
            <div class="intro">
              <h3>{member.name}</h3>
              <h4>{member.position}</h4>
              <p>{member.desc}</p>
              <ul class="socials">
                {member.socials.map((social) => (
                  <li>
                    <a href={social.link}>
                      <i class={`fa fa-${social.icon}`}></i>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="four spacing"></div>
    <script
      is:inline
      src="https://widgets.leadconnectorhq.com/loader.js"
      data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js"
      data-widget-id="66b4950204b58084a9a7e054"
    ></script>
  </div>
</OnePageLayout>
