---
// /newsletter/<year>/<slug>/ — newsletter detail page.
//
// Wynn task #678 (2026-06-13). Mark's Q2 decision: year-segmented URLs.
//
// Renders one newsletter entry, with hero image (if set), preheader as a
// kicker line, subject as <h1>, and rendered markdown body. Uses the same
// `mod modBlogPost` shell as PostLayout so brand styling matches the rest
// of the site.

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { newsletterPermalink, getSortedNewsletters, newsletterHref } from '../../../utils/newsletter';
import type { GetStaticPaths } from 'astro';
import { promises as fs } from 'node:fs';
import path from 'node:path';

export const getStaticPaths: GetStaticPaths = async () => {
  const items = await getCollection('newsletter', ({ data }) => !data.draft);
  return items.map((entry) => {
    const date = entry.data.date instanceof Date ? entry.data.date : new Date(entry.data.date);
    const year = String(date.getUTCFullYear());
    return {
      params: { year, slug: entry.data.slug },
      props: { entry },
    };
  });
};

interface Props {
  entry: CollectionEntry<'newsletter'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// High-fidelity HTML body (Wynn task #692, 2026-06-13). When `html_body` is
// set in frontmatter, the value is a filename adjacent to the .md entry
// inside src/content/newsletter/<year>/. We read it from disk at build time
// and render it inside an isolated iframe via `srcdoc` (task #700) so the
// email's CSS can't clash with the host page's Foundation chrome.
// The HTML has already been sanitised + had its image URLs rewritten to
// local paths by scripts/backfill-newsletter-html.ts.
const entryDate = entry.data.date instanceof Date ? entry.data.date : new Date(entry.data.date);
let htmlBody: string | null = null;
if (entry.data.html_body) {
  const yearSeg = String(entryDate.getUTCFullYear());
  // Build runs with cwd at the astro project root, so resolve from there.
  // Using process.cwd() instead of import.meta.url because the bundled
  // build output sits at a different filesystem path than the .astro source.
  const htmlPath = path.resolve(
    process.cwd(),
    'src/content/newsletter',
    yearSeg,
    entry.data.html_body,
  );
  try {
    htmlBody = await fs.readFile(htmlPath, 'utf-8');
    // Prepend Astro's BASE_URL to root-relative asset paths so images resolve
    // under /preview/ (staging) and / (production) without the rewriter
    // having to know which environment it's targeting. iframe srcdoc still
    // resolves relative URLs against the host page's origin, so this rewrite
    // is still required.
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    if (base) {
      htmlBody = htmlBody.replace(/(src|href)="\/assets\//g, `$1="${base}/assets/`);
    }
  } catch (e) {
    // Fall back to markdown render if the sibling is missing — surface a
    // build warning so we notice.
    console.warn(`[newsletter] ${entry.data.slug}: html_body=${entry.data.html_body} not found at ${htmlPath}`);
    htmlBody = null;
  }
}

// Build a standalone HTML document for the iframe srcdoc. <base target="_parent">
// makes email links open in the parent tab (not trapped inside the iframe).
// The inline script posts the document height up to the host page so the
// iframe can auto-resize to fit its content with no scrollbars.
const iframeDoc = htmlBody ? `<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <base target="_parent">
  </head>
  <body>
${htmlBody}
<script>
(function () {
  function post() {
    parent.postMessage({ type: 'newsletter-iframe-height', height: document.documentElement.scrollHeight }, '*');
  }
  window.addEventListener('load', post);
  if (window.ResizeObserver) {
    new ResizeObserver(post).observe(document.documentElement);
  }
})();
</script>
  </body>
</html>` : null;

const date = entry.data.date instanceof Date ? entry.data.date : new Date(entry.data.date);
const formattedDate = date.toLocaleDateString('en-US', {
  month: 'long',
  day: '2-digit',
  year: 'numeric',
});

// Description — preheader if set, else first ~30 words of body.
const description = entry.data.preheader ?? `Aerial Edge newsletter — ${entry.data.subject}, sent ${formattedDate}.`;

// Previous + next navigation (chronological).
const all = await getSortedNewsletters();
const idx = all.findIndex((e) => e.id === entry.id);
const newer = idx > 0 ? all[idx - 1] : null;
const older = idx < all.length - 1 ? all[idx + 1] : null;
---
<BaseLayout
  title={`${entry.data.subject} — Aerial Edge Newsletter`}
  description={description}
  extraRssFeeds={[{ title: 'Aerial Edge Newsletter', href: '/newsletter/feed.xml' }]}
>
  <div class="full">
    <div class="row">
      <div class="large-8 columns large-centered">
        <div class="section-title">
          <p class="small-title">newsletter / {formattedDate}</p>
          <h2>{entry.data.subject}</h2>
        </div>
      </div>
    </div>
  </div>

  <div class="full no-padding">
    <div class="row">
      <div class="large-8 large-centered columns">
        <div class="mod modBlogPost big no_bg">
          {/* Hero image strip + preheader render only for the markdown path.
              The full-HTML path includes its own hero + chrome via the email
              body, so showing them again here would duplicate. (task #692) */}
          {!htmlBody && entry.data.hero_image && (
            <div class="images">
              <div class="image">
                <img width="800" height="533" alt="" src={entry.data.hero_image} />
              </div>
            </div>
          )}

          <div class="content">
            {!htmlBody && entry.data.preheader && (
              <p class="info"><em>{entry.data.preheader}</em></p>
            )}
            {iframeDoc ? (
              <iframe
                class="newsletter-iframe"
                style="width:100%; border:0; display:block; background:#fff;"
                loading="lazy"
                srcdoc={iframeDoc}
              ></iframe>
            ) : (
              <Content />
            )}
          </div>
        </div>

        <hr />
        <div class="two spacing"></div>

        {/* Previous / next navigation. */}
        <div class="row">
          <div class="large-6 columns">
            {older ? (
              <a class="button small boxed" href={newsletterHref(older)}>
                ← Older: {older.data.subject}
              </a>
            ) : (
              <span></span>
            )}
          </div>
          <div class="large-6 columns text-right" style="text-align: right;">
            {newer ? (
              <a class="button small boxed" href={newsletterHref(newer)}>
                Newer: {newer.data.subject} →
              </a>
            ) : (
              <span></span>
            )}
          </div>
        </div>

        <div class="two spacing"></div>

        <p>
          <a class="button small boxed yellow" href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/newsletter/'}>
            ← Back to archive
          </a>
        </p>
      </div>
    </div>
  </div>

  <div class="four spacing"></div>

  {/*
    Iframe auto-resize (task #700). The srcdoc iframe posts its document
    height up via postMessage; we set the iframe's pixel height to match so
    the email renders inline with no inner scrollbars. +8px buffer absorbs
    sub-pixel rounding.
  */}
  <script is:inline>
    window.addEventListener('message', function(e) {
      if (!e.data || e.data.type !== 'newsletter-iframe-height') return;
      var iframe = document.querySelector('iframe.newsletter-iframe');
      if (iframe && typeof e.data.height === 'number') {
        iframe.style.height = (e.data.height + 8) + 'px';
      }
    });
  </script>
</BaseLayout>
