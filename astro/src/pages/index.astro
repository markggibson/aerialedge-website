---
// / — port of v1 index.html. The homepage.
// v1 layout: default, onepage=true. Permalink: /.
//
// Custom masonry-tile works grid pulls from the works content collection
// and is initialised with the vendored Masonry runtime
// (/assets/javascripts/masonry.pkgd.min.js, vendored in Phase 3 per P3-A).
// Per brief: "Wire up the Masonry runtime call here … target
// .modMasonryGallery .gallery".
//
// Stock content (per brief, carried verbatim):
//   - members[] includes "Mark Wayne", "Clare Watson", "Jone Bucan"
//     placeholders with @stock avatars and lorem-ish bios — preserved.
//   - testimonials[] all attributed to "David White" with Designer/Huglab
//     placeholder copy — preserved.
//   - clients[] paths under /@stock/client-*.png — preserved.
//   - The members + testimonials + clients sections are all Liquid-
//     commented in v1 and never rendered. Not ported as visible HTML.
//   - services[] (pricing cards) IS rendered on v1 — ported here with
//     the exact same £ figures (£7.5, £8, £10, £17, £20, £25, £12.50,
//     £17.50, £12, £20).
//
// Other v1 quirks preserved:
//   - Multiple <video id="fullscreen-video"> elements share the same id
//     across the page (browser will only act on the first). Verbatim.
//   - Many "How we work" / customers-bg / team / blog / clients sections
//     are HTML-commented in v1 and never render. Not ported.
//   - The "Foundation Course Show Reels" video URLs use real
//     aerialedge.co.uk paths; left as-is for Rochen post-cutover.

import { getCollection } from 'astro:content';
import OnePageLayout from '../layouts/OnePageLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ContactForm from '../components/ContactForm.astro';
import SocialNetworks from '../components/SocialNetworks.astro';

const services = [
  { title: 'Circus fitness', icon: 'fa fa-heart',         desc1: '£7.5 (8-class pass)',  desc2: '£8 (4-class pass)',     desc3: '£10 (drop-in)' },
  { title: 'Aerial',         icon: 'fa  fa-arrow-up',     desc1: '£17 (8-class pass)',   desc2: '£20 (4-class pass)',    desc3: '£25 (drop-in)' },
  { title: 'Acro',           icon: 'fa  fa-arrow-down',   desc1: '£12.50 (8-class pass)', desc2: '£17.50 (4-class pass)', desc3: '£20 (drop-in)' },
  { title: 'Youth circus',   icon: 'fa  fa-child',        desc1: '£12 (book the term)',  desc2: '£20 (drop-in)',         desc3: '' },
];

// works[] frontmatter in v1 references _works/ files by path; here we
// resolve by the new slug (matches plan §3 + P4-B works collection).
// Order and per-tile `style: wide` flag preserved verbatim.
interface WorkRef { slug: string; style?: 'wide' }
const workRefs: WorkRef[] = [
  { slug: 'circus-fitness' },
  { slug: 'aerial-edge-circus-challenge' },
  { slug: 'youth-circus', style: 'wide' },
  { slug: 'aerial-acrobatic-arts' },
  { slug: 'rigging-training' },
  { slug: 'full-time-pro-training', style: 'wide' },
  { slug: 'parties-private-lessons' },
  { slug: 'circus-cinematography' },
];

const allWorks = await getCollection('works');
const worksBySlug = new Map(allWorks.map((w) => [w.data.slug, w]));
const works = workRefs.map((ref) => {
  const w = worksBySlug.get(ref.slug);
  if (!w) throw new Error(`homepage references unknown work slug: ${ref.slug}`);
  return { ref, work: w };
});

function downcaseCapitalize(s: string) {
  return s.length === 0 ? s : s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();
}
---
<OnePageLayout title="Aerial Edge">

