---
// / — port of v1 index.html. The homepage.
//
// Post-#210 (2026-05-17): content lives in the Sveltia-editable `homepage`
// singleton (src/content/homepage/index.md). This file is a thin renderer
// that consumes the singleton entry. Mark edits blocks via /admin/; Sveltia
// commits to main; deploy-prod.yml ships in ~3 min.
//
// Schema source of truth: src/content.config.ts → `homepage` collection.
// Sveltia mirror: public/admin/config.yml → "Homepage" files-collection.
//
// NOT Sveltia-editable (stay hardcoded):
//   - Latest 3 articles (auto-pulled from `posts` collection)
//   - GHL newsletter form + Address + Vimeo embed (ContactForm component)
//   - Social block (SocialNetworks component)
//   - FooterMenu (BaseLayout)
//   - Multiple <video id="fullscreen-video"> elements sharing the same id
//     (v1 quirk preserved — browser only acts on the first)
//   - Vendored Masonry runtime call at the bottom (structural JS, not content)
//
// v1 stock content / dead sections (testimonials, "Mark Wayne" team
// placeholders, commented-out customers-bg/team/blog/clients sections) are
// untouched. They never rendered in v1; they don't render here.

import { Fragment } from 'astro/jsx-runtime';
import { getCollection, getEntry } from 'astro:content';
import OnePageLayout from '../layouts/OnePageLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ContactForm from '../components/ContactForm.astro';
import SocialNetworks from '../components/SocialNetworks.astro';
import { withBase } from '../utils/url';

// Singleton entry — exactly one file lives in src/content/homepage/.
const homepageEntry = await getEntry('homepage', 'index');
if (!homepageEntry) {
  throw new Error(
    'Missing src/content/homepage/index.md — the homepage singleton entry is required.',
  );
}
const home = homepageEntry.data;

// Resolve `works` references for the Masonry grid. Astro's reference() in the
// schema validates that each slug exists in the `works` collection at build
// time; here we just join to get the actual entry data for rendering.
const allWorks = await getCollection('works');
const worksBySlug = new Map(allWorks.map((w) => [w.data.slug, w]));
// In Astro 6, reference() values resolve at validation time to entries shaped
// like { collection, id }. We accept either string ids (slug) or the resolved
// shape, and look up by data.slug (the explicit slug field set on each work).
type WorkRef = { collection: string; id: string } | string;
function refToSlug(r: WorkRef): string {
  return typeof r === 'string' ? r : r.id;
}
const works = home.works_section.tiles.map((tile) => {
  const slug = refToSlug(tile.work as WorkRef);
  const w = worksBySlug.get(slug);
  if (!w) throw new Error(`homepage references unknown work slug: ${slug}`);
  return { tile, work: w };
});

function downcaseCapitalize(s: string) {
  return s.length === 0 ? s : s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();
}
---
<OnePageLayout title="Aerial Edge">

  <div class="full no-padding parallax home-video-wrapper">
    <div class="fullscreen">
      <video muted autoplay="autoplay" playsinline id="fullscreen-video" loop="loop">
        <source src={home.hero.video_src} type="video/mp4" />
      </video>
      <div class="overlay"></div>
      <div class="layer">
        <p class="small-title">{home.hero.small_title}</p>
        <h1 class="thin" id="to-be-update">
          {home.hero.title_lines.map((line, i) => {
            // v1 styles the three hero title lines with .fir / .sec / .thir
            // CSS classes by position. Schema is a flat array; we assign the
            // classes by index, with .thir as the fallback for any 4th+ line.
            const cls = i === 0 ? 'fir' : i === 1 ? 'sec' : 'thir';
            const isLast = i === home.hero.title_lines.length - 1;
            return (
              <>
                <span class={cls}>{line}</span>{!isLast && <br />}
              </>
            );
          })}
        </h1>

        {/* v1 hero rendered three <a class="button">s on separate source lines,
            producing whitespace text nodes between them. Without those text
            nodes the inline-block buttons abut with zero visible gap. We
            interleave a literal space between consecutive buttons to
            restore v1's between-button spacing. */}
        {home.hero.cta_buttons.map((btn, i) => (
          <Fragment>
            {i > 0 && ' '}
            <a href={btn.url} target={btn.target} class="button small">{btn.text}</a>
          </Fragment>
        ))}

        <div class="two spacing"></div>

        <h2 class="thin" set:html={home.hero.body_html}></h2>
      </div>
    </div>
  </div>

  <a id="about"></a>
  <div class="full">
    <div class="row">
      <div class="large-8 columns large-centered">
        <div class="section-title">
          <p class="small-title">{home.about.small_title}</p>
          <h2>{home.about.title}</h2>
          <p class="big-size">{home.about.body}</p>
          <div class="four spacing"></div>
          <img src={home.about.image} alt="" />
        </div>
      </div>
      <div class="four spacing"></div>
    </div>
  </div>

  <div class="full dark no-padding ">
    <div class="four spacing"></div>
    <div class="row">
      <div class="large-8 columns">
        <h3 class="white">{home.intensive.title}</h3>
        <p>{home.intensive.body}</p>
      </div>
      <div class="large-4 columns">
        <p>
          <a class="button small boxed" href={withBase(home.intensive.button.url)} target={home.intensive.button.target}>{home.intensive.button.text}</a>
        </p>
      </div>
    </div>
    <div class="two spacing"></div>
  </div>

  <a id="works"></a>
  <div class="full">
    <div class="row">
      <div class="large-8 columns large-centered">
        <SectionTitle smallTitle={home.works_section.small_title} title={home.works_section.title} />
        <p class="big-size">{home.works_section.intro}</p>
      </div>
    </div>
  </div>

  <div class="full no-padding" id="demo-1-works">
    <div class="mod modMasonryGallery">
      <ul class="gallery">
        {works.map(({ tile, work }) => {
          const isWide = tile.style === 'wide';
          const w = isWide ? 1000 : 500;
          const h = 350;
          const liClass = isWide ? 'wide' : '';
          const url = withBase(`/portfolio/${work.data.slug}/`);
          const cats = (work.data.categories ?? []).join(' & ');
          return (
            <li class={liClass}>
              <a href={url}>
                <img width={w} height={h} alt="" src={work.data.thumbnail} />
                <div class="overlay">
                  <div class="thumb-info">
                    <h3>{downcaseCapitalize(work.data.title)}</h3>
                    <p>{cats}</p>
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>

  <a id="vouchers"></a>
  <div class="full no-padding">
    <div class="four spacing"></div>
    <div class="row">
      <div class="large-6 columns">
        <div class="section-title">
          <h3>{home.vouchers.title}</h3>
          <p class="big-size">{home.vouchers.body}</p>
          <img src={home.vouchers.image} alt="" />
          <div class="two spacing"></div>
          <p>
            <a class="button small" href={home.vouchers.button.url} target={home.vouchers.button.target}>{home.vouchers.button.text}</a>
          </p>
        </div>
      </div>
      <div class="large-6 columns">
        <div class="section-title">
          <h3>{home.store.title}</h3>
          <p class="big-size">{home.store.body}</p>
          <img src={home.store.image} alt="" />
          <div class="two spacing"></div>
          <p>
            <a class="button small" href={home.store.button.url} target={home.store.button.target}>{home.store.button.text}</a>
          </p>
        </div>
      </div>
    </div>
  </div>

  {home.program_features.map((feat) => (
    feat.kind === 'video' ? (
      <div class="full no-padding parallax home-video-wrapper">
        <div class="fullscreen">
          <video muted autoplay="autoplay" playsinline id="fullscreen-video" loop="loop">
            <source src={feat.video_src} type="video/mp4" />
          </video>
          <div class="overlay"></div>
          <div class="layer">
            <p class="small-title">{feat.small_title}</p>

            {feat.title_lines.map((line) => (
              <h2 class="thin">
                {line}
              </h2>
            ))}
            {feat.button && (
              <>
                <div class="two spacing"></div>
                <a href={feat.button.url} target={feat.button.target} class="button small">{feat.button.text}</a>
              </>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div class="full dark no-padding ">
        <div class="four spacing"></div>
        <div class="row">
          <div class="large-8 columns">
            <h3 class="white">{feat.title}</h3>
            <p>{feat.body}</p>
          </div>
          <div class="large-4 columns">
            <p>
              {feat.button && (
                <a class="button small boxed" href={feat.button.url} target={feat.button.target}>{feat.button.text}</a>
              )}
            </p>
          </div>
        </div>
        <div class="two spacing"></div>
      </div>
    )
  ))}

  <a id="pricing"></a>
  <div class="full">
    <div class="row">
      <div class="large-8 columns large-centered">
        <div class="section-title">
          <p class="small-title">{home.pricing.small_title}</p>
          <h2>{home.pricing.title}</h2>
        </div>
      </div>
    </div>
  </div>

  <div class="full no-overflow no-padding">
    <div class="main-services">
      {home.pricing.cards.map((card) => (
        <div class="medium-6 large-3 columns">
          {/* v1 carried `moveup` (+ data-delay) here as a fade-in-on-scroll
              hook. The handler lived in jQuery + jquery.appear.js, which the
              Phase-3 Bower strip removed. Without the JS, `.moveup` stays at
              opacity:0 and the cards never paint. Class dropped 2026-05-17
              (task #214 r2). If we ever re-wire a scroll-fade animation, add
              the class back deliberately. */}
          <div class="mod modIconText">
            <div class="icon-text-advanced">
              <div class="wrapper">
                <div class="content">
                  <i class={card.icon}></i>
                </div>
              </div>
              <h2>{card.title}</h2>
              {/* v1 quirk preserved: each price tier wraps an <hN> inside a <p>.
                  The first tier is <h3>, the rest are <h4>. Order matters. */}
              {card.price_tiers.map((tier, i) => (
                i === 0
                  ? <p><h3>{tier}</h3></p>
                  : <p><h4>{tier}</h4></p>
              ))}
              {/* Pad to four <p> rows so all cards align — v1 always emitted
                  four desc slots (desc1/2/3 plus the implicit blank). */}
              {Array.from({ length: Math.max(0, 3 - card.price_tiers.length) }).map(() => (
                <p><h4></h4></p>
              ))}
              <div class="spacing"></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="full dark no-padding ">
    <div class="two spacing"></div>
  </div>

  <a id="vouchers"></a>
  <div class="full no-padding">
    <div class="four spacing"></div>
    <div class="row">
      <div class="large-12 columns">
        <div class="section-title">
          <h3>{home.timetable.title}</h3>
          <img src={home.timetable.image} alt="" />
          <div class="two spacing"></div>
          <p>
            <a href={home.timetable.button.url} target={home.timetable.button.target} class="button small">{home.timetable.button.text}</a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="full dark no-padding ">
    <div class="four spacing"></div>
    <div class="row">
      <div class="large-8 columns">
        <h3 class="white">{home.training_callout.title}</h3>
        <p>{home.training_callout.body}</p>
      </div>
      <div class="large-4 columns">
        <p>
          <a class="button small boxed" href={withBase(home.training_callout.button.url)} target={home.training_callout.button.target}>{home.training_callout.button.text}</a>
        </p>
      </div>
    </div>
    <div class="two spacing"></div>
  </div>

  <a id="blog"></a>
  <div class="full grey">
    <div class="row">
      <div class="large-8 columns large-centered">
        <SectionTitle smallTitle="latest posts" title="Articles" />
      </div>
    </div>
  </div>
  <div class="full grey no-padding no-overflow">
    {await (async () => {
      const { getSortedPosts, postHref } = await import('../utils/blog');
      const latest = (await getSortedPosts()).slice(0, 3);
      const formatDate = (d: Date | string) => {
        const obj = d instanceof Date ? d : new Date(d);
        return obj.toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' });
      };
      return latest.map((post) => (
        <div class="large-4 columns">
          <div class="mod modBlogPost simple">
            <div class="content">
              <p class="date">{formatDate(post.data.date)}</p>
              <h3><a href={postHref(post)}>{post.data.title}</a></h3>
              <div class="spacing"></div>
              <p>
                <a class="button boxed yellow tiny" href={postHref(post)}>Read more</a>
              </p>
            </div>
          </div>
          <div class="four spacing"></div>
        </div>
      ));
    })()}
  </div>

  <div class="four spacing"></div>
  <a id="contact"></a>
  <ContactForm />

  <SocialNetworks />

  {/*
    Homepage-only JS: vendored Masonry + imagesloaded to lay out the
    works grid (Phase 4 brief: target .modMasonryGallery .gallery).
    Loaded with `defer` so the masonry call runs after the body parses.
  */}
  <script is:inline src="/assets/javascripts/imagesloaded.pkgd.js" defer></script>
  <script is:inline src="/assets/javascripts/masonry.pkgd.min.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var grid = document.querySelector('.modMasonryGallery .gallery');
      if (!grid || typeof Masonry === 'undefined') return;
      var msnry = new Masonry(grid, {
        itemSelector: 'li',
        columnWidth: 'li:not(.wide)',
        percentPosition: true,
      });
      if (typeof imagesLoaded === 'function') {
        imagesLoaded(grid, function () { msnry.layout(); });
      }
    });
  </script>
</OnePageLayout>
