      </div>
    </div>
  </div>

  <div class="full no-padding" id="demo-1-works">
    <div class="mod modMasonryGallery">
      <ul class="gallery">
        {works.map(({ ref, work }) => {
          const isWide = ref.style === 'wide';
          const w = isWide ? 1000 : 500;
          const h = 350;
          const liClass = isWide ? 'wide' : '';
          const url = `/portfolio/${work.data.slug}/`;
          const cats = (work.data.categories ?? []).join(' & ');
          return (
            <li class={liClass}>
              <a href={url}>
                <img width={w} height={h} alt="" src={work.data.thumbnail} />
                <div class="overlay">
                  <div class="thumb-info">
                    <h3>{downcaseCapitalize(work.data.title)}</h3>
                    <p>{cats}</p>
