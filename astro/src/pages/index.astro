    <div class="two spacing"></div>
  </div>

  <div class="full no-padding parallax home-video-wrapper">
    <div class="fullscreen">
      <video muted autoplay="autoplay" playsinline id="fullscreen-video" loop="loop">
        <source src="/assets/images/videos/Aerials-no-titles.mp4" type="video/mp4" />
      </video>
      <div class="overlay"></div>
      <div class="layer">
        <p class="small-title">Aerial Classes</p>

        <h2 class="thin">
          Weekdays and  weekends
        </h2>
        <h2 class="thin">
          Come and get upside down with us! Learn to perform exciting and different tricks and moves on aerial equipment including trapeze, hoop, silks (aka lyra), rope and more. Make your Instagram pop!
        </h2>
        <div class="two spacing"></div>
        <a href="https://goteamup.com/p/3751555-aerial-edge/" target="_blank" class="button small">Book a class</a>
      </div>
    </div>
  </div>

  <a id="pricing"></a>
  <div class="full">
    <div class="row">
      <div class="large-8 columns large-centered">
