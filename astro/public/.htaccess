# Aerial Edge — apex canonical redirects + cache-control policy.
#
# ─────────────────────────────────────────────────────────────────
# Section 1 — Canonical-host 301s (task #312, 2026-05-26).
#
# Force every request to https://aerialedge.co.uk (no www, no http).
# Splits previously caused link-equity dilution + duplicate-content
# noise (audit findings A2/A3, Deliverables/website-seo-audit-2026-05-17).
#
# Rules:
#   - http://aerialedge.co.uk/*       → https://aerialedge.co.uk/*
#   - https://www.aerialedge.co.uk/*  → https://aerialedge.co.uk/*
#   - http://www.aerialedge.co.uk/*   → https://aerialedge.co.uk/*
#
# Implemented as two mod_rewrite rules:
#   - one match-by-host for www (covers http+https www together)
#   - one match-by-scheme for http (covers apex http)
#
# These rules are no-ops inside /preview/ — the staging build lives
# under public_html/preview/, served at https://aerialedge.co.uk/preview/.
# Requests there already arrive as https + apex, so no redirect fires.
# ─────────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Strip the www. subdomain (https→https, http→http; the http→https
  #    rule below then upgrades the scheme on the second pass).
  RewriteCond %{HTTP_HOST} ^www\.aerialedge\.co\.uk$ [NC]
  RewriteRule ^(.*)$ https://aerialedge.co.uk/$1 [R=301,L]

  # 2. Force HTTPS on the apex host. %{HTTPS} is "off" on cleartext
  #    requests, "on" on TLS — LiteSpeed honours both per Apache spec.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^aerialedge\.co\.uk$ [NC]
  RewriteRule ^(.*)$ https://aerialedge.co.uk/$1 [R=301,L]

  # ───────────────────────────────────────────────────────────────
  # Section 2 — Page-level 301s.
  #
  # /1-year-pdc/ → /professional-development-programme/ (task #733,
  # 2026-06-15). The 1-Year PDC retired; its page was repurposed into
  # the Professional Development Programme at a new accurate slug. This
  # 301 preserves inbound links and SEO equity from the old URL.
  #
  # Matches /1-year-pdc and /1-year-pdc/ (with optional trailing path);
  # leading-slash anchored so it never fires under /preview/.
  RewriteRule ^1-year-pdc/?$ /professional-development-programme/ [R=301,L]
</IfModule>

# Aerial Edge cache-control policy — task #208 (2026-05-17).
#
# Proposal / rationale:
#   Deliverables/website-redev/cache-control-strategy-2026-05-17/proposal.md
#
# WHY: Rochen serves a default Cache-Control (currently observed as
# `public, max-age=86400` on /preview/ assets and `public, max-age=604800`
# on apex assets) which causes:
#   - Sveltia admin assets (config.yml, index.html) sticky in the
#     browser — config changes invisible until hard reload
#     (2026-05-16 missing-landing-pages-collection bug).
#   - Un-hashed CSS/JS at /assets/css/* and /assets/javascripts/* keep
#     stale content for up to a week after deploy (2026-05-17 hero-fix
#     CSS deploy chain misdiagnosed as failed).
#
# This file overrides the default with per-path rules. LiteSpeed honours
# Apache mod_headers / mod_expires / mod_mime / core <If> syntax.
#
# IMPORTANT: <Location> and <LocationMatch> are NOT allowed in .htaccess
# context — only in server / vhost scope. LiteSpeed silently ignores
# them (verified 2026-05-17). This file uses <If> expressions on
# %{REQUEST_URI} instead, which IS valid in .htaccess and works on
# LiteSpeed Enterprise.
#
# Verify with: curl -I https://aerialedge.co.uk/<path>

# ─────────────────────────────────────────────────────────────────
# MIME type fix — config.yml is served as application/octet-stream
# by default. Sveltia tolerates it, but text/yaml is correct.
# ─────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType text/yaml .yml
  AddType text/yaml .yaml
</IfModule>

<IfModule mod_headers.c>

  # ─────────────────────────────────────────────────────────────────
  # Order: we set the broadest rule first, then more-specific rules
  # override it. `Header set` (not `Header append`) overwrites any
  # previously-set Cache-Control on the same response.
  #
  # The <If> directive matches against %{REQUEST_URI}, which on
  # LiteSpeed for a request like https://host/preview/foo.css is
  # "/preview/foo.css" — even when this .htaccess lives inside
  # public_html/preview/. Confirmed on Apache 2.4 + LiteSpeed.
  # ─────────────────────────────────────────────────────────────────

  # General /assets/images/ — moderate cache (1 day). Broad rule;
  # specific cms/ rule below overrides it.
  <If "%{REQUEST_URI} =~ m#^/(preview/)?assets/images/#">
    Header set Cache-Control "public, max-age=86400"
  </If>

  # Future /assets/videos/ — moderate cache (1 day).
  <If "%{REQUEST_URI} =~ m#^/(preview/)?assets/videos/#">
    Header set Cache-Control "public, max-age=86400"
  </If>

  # Fonts — stable, long-cache.
  <If "%{REQUEST_URI} =~ m#^/(preview/)?assets/fonts/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Un-hashed CSS — 5-min freshness, must revalidate. patch.css fix.
  <If "%{REQUEST_URI} =~ m#^/(preview/)?assets/css/#">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </If>

  # Un-hashed JS — same as CSS.
  <If "%{REQUEST_URI} =~ m#^/(preview/)?assets/javascripts/#">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </If>

  # Sveltia CMS-uploaded images — short cache (Sveltia overwrites
  # in place). Must come AFTER the general /assets/images/ rule so
  # it overrides for the cms/ subpath.
  <If "%{REQUEST_URI} =~ m#^/(preview/)?assets/images/cms/#">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </If>

  # Astro content-hashed bundles — safe to cache forever.
  <If "%{REQUEST_URI} =~ m#^/(preview/)?_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # HTML pages (apex and preview) — revalidate every load.
  # Covers both `.html` files and directory-index requests.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#/$#">
    Header set Cache-Control "no-cache, must-revalidate"
  </If>

  # Sveltia admin — `no-store` so config and bundle ALWAYS refresh.
  # MUST come last so it overrides the HTML rule for /admin/index.html
  # and the catch-all for /admin/config.yml.
  <If "%{REQUEST_URI} =~ m#^/(preview/)?admin(/|$)#">
    Header set Cache-Control "no-store, must-revalidate"
    Header set Pragma "no-cache"
  </If>

</IfModule>
